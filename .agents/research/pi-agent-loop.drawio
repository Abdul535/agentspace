</mxCell>
<mxCell id="o_rprep" value="&lt;b&gt;prepare_tool_call()&lt;/b&gt;&lt;br&gt;tool found? → arguments_error? → prepare_arguments(copy)&lt;br&gt;→ model_validate → &lt;b&gt;before_tool_call&lt;/b&gt;&lt;br&gt;no abort check (cancel stops the task) · a crashing hook blocks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="2280" y="515" width="360" height="85" as="geometry"/>
</mxCell>
<mxCell id="o_rimm" value="returned a&lt;br&gt;FinishedCall (refused)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="2360" y="630" width="200" height="80" as="geometry"/>
</mxCell>
<mxCell id="o_rexec" value="&lt;b&gt;execute_prepared()&lt;/b&gt;&lt;br&gt;tool.execute(args, ctx) · ctx.on_update → tool_execution_update&lt;br&gt;ToolError / any exception → error result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="2280" y="745" width="360" height="65" as="geometry"/>
</mxCell>
<mxCell id="o_rfin" value="&lt;b&gt;finalize_tool_call()&lt;/b&gt;&lt;br&gt;&lt;b&gt;after_tool_call&lt;/b&gt; overrides content / details / is_error /&lt;br&gt;terminate · a crashing hook → error result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
