        <mxCell id="r9" edge="1" parent="1" source="r_end" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" target="r_msgs" value="all calls done">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      <mxCell id="o_wrap" value="agentspace today: what the web app talks to (apps/api: api/sessions.py, agent/loop.py). Colors here show status" style="swimlane;startSize=28;rounded=1;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
  <mxGeometry x="1480" y="-58" width="1200" height="120" as="geometry"/>
</mxCell>
<mxCell id="o_w_prompt" value="&lt;b&gt;POST /sessions/{id}/messages&lt;/b&gt;&lt;br&gt;→ run_agent · 409 if a run is going" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="o_wrap">
  <mxGeometry x="15" y="45" width="180" height="55" as="geometry"/>
</mxCell>
<mxCell id="o_w_cont" value="&lt;b&gt;continue()&lt;/b&gt;&lt;br&gt;not built (step 15)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#777777;fontSize=11;" vertex="1" parent="o_wrap">
  <mxGeometry x="210" y="45" width="170" height="55" as="geometry"/>
</mxCell>
<mxCell id="o_w_steer" value="&lt;b&gt;steer()&lt;/b&gt;&lt;br&gt;not built (step 14)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#777777;fontSize=11;" vertex="1" parent="o_wrap">
  <mxGeometry x="395" y="45" width="190" height="55" as="geometry"/>
</mxCell>
<mxCell id="o_w_follow" value="&lt;b&gt;followUp()&lt;/b&gt;&lt;br&gt;not built (step 14)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#777777;fontSize=11;" vertex="1" parent="o_wrap">
  <mxGeometry x="600" y="45" width="200" height="55" as="geometry"/>
</mxCell>
<mxCell id="o_w_abort" value="&lt;b&gt;abort&lt;/b&gt;: closing the SSE stream&lt;br&gt;cancels the loop task&lt;br&gt;(abort route: step 13)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="o_wrap">
  <mxGeometry x="815" y="45" width="180" height="55" as="geometry"/>
</mxCell>
<mxCell id="o_w_sub" value="&lt;b&gt;SSE stream&lt;/b&gt; (run_agent: task → Queue)&lt;br&gt;route saves each message_end" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="o_wrap">
  <mxGeometry x="1010" y="45" width="175" height="55" as="geometry"/>
</mxCell>
<mxCell id="o_left" value="run_loop (agent/loop.py)" style="swimlane;startSize=28;rounded=1;html=1;fillColor=none;strokeColor=#82b366;" vertex="1" parent="1">
  <mxGeometry x="1480" y="170" width="720" height="1430" as="geometry"/>
</mxCell>
<mxCell id="o_start" value="run_loop(prompt)&lt;br&gt;emit agent_start · prompt message_start / end" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="1640" y="210" width="280" height="55" as="geometry"/>
</mxCell>
<mxCell id="o_poll" value="no steering poll&lt;br&gt;(step 14)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#777777;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="1640" y="295" width="280" height="50" as="geometry"/>
</mxCell>
<mxCell id="o_prep" value="&lt;b&gt;for turn in 1..max_turns&lt;/b&gt;: emit turn_start&lt;br&gt;no prepareNextTurn: compaction is step 17" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="1640" y="385" width="280" height="60" as="geometry"/>
</mxCell>
<mxCell id="o_push" value="no pending messages to push,&lt;br&gt;no tool-change messages (step 22)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#777777;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="1640" y="480" width="280" height="55" as="geometry"/>
</mxCell>
<mxCell id="o_req" value="no prepareRequest&lt;br&gt;(step 19)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#777777;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="1640" y="570" width="280" height="50" as="geometry"/>
</mxCell>
<mxCell id="o_stream" value="&lt;b&gt;provider.stream(model, Context)&lt;/b&gt;&lt;br&gt;emit message_start · message_update · message_end" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="1640" y="655" width="280" height="60" as="geometry"/>
</mxCell>
<mxCell id="o_streamnote" value="Updates only for text deltas and finished tool calls. No transformContext / convertToLlm (16, 17), getApiKey (20) or thinking (18).&lt;br&gt;&lt;br&gt;Extra: a stream with no final message becomes an error reply." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
  <mxGeometry x="1960" y="630" width="240" height="105" as="geometry"/>
</mxCell>
<mxCell id="o_err" value="stop_reason&lt;br&gt;error / aborted?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="1680" y="750" width="200" height="80" as="geometry"/>
</mxCell>
<mxCell id="o_errout" value="finish_turn (can't keep it going) · turn_end&lt;br&gt;reason = error | aborted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="1960" y="760" width="240" height="60" as="geometry"/>
</mxCell>
<mxCell id="o_tc" value="calls = assistant.tool_calls()&lt;br&gt;(no branch: an empty batch does nothing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="1640" y="875" width="280" height="60" as="geometry"/>
</mxCell>
<mxCell id="o_batch" value="&lt;b&gt;execute_tool_calls()&lt;/b&gt; →&lt;br&gt;(stop_reason length → every call fails&lt;br&gt;with TRUNCATED_CALL)&lt;br&gt;returns FinishedCall list" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="1640" y="975" width="280" height="75" as="geometry"/>
</mxCell>
<mxCell id="o_finish" value="&lt;b&gt;finish_turn()&lt;/b&gt; → end | continue | None&lt;br&gt;emit turn_end" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="1640" y="1090" width="280" height="55" as="geometry"/>
</mxCell>
<mxCell id="o_end" value="decision?&lt;br&gt;end → stop · continue → next turn" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="1650" y="1175" width="260" height="85" as="geometry"/>
</mxCell>
<mxCell id="o_more" value="no calls → done&lt;br&gt;every call terminate → terminated&lt;br&gt;else next turn" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="1640" y="1285" width="280" height="95" as="geometry"/>
</mxCell>
<mxCell id="o_follow" value="out of turns → reason = max_turns&lt;br&gt;(pi has no cap; follow-ups: step 14)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="1640" y="1420" width="280" height="55" as="geometry"/>
</mxCell>
<mxCell id="o_agentend" value="emit agent_end(reason, new_messages)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="1660" y="1525" width="240" height="55" as="geometry"/>
</mxCell>
<mxCell id="o_right" value="Tool batch: execute_tool_calls (agent/loop.py)" style="swimlane;startSize=28;rounded=1;html=1;fillColor=none;strokeColor=#82b366;" vertex="1" parent="1">
  <mxGeometry x="2240" y="170" width="440" height="960" as="geometry"/>
</mxCell>
<mxCell id="o_mode" value="tool_execution sequential,&lt;br&gt;a tool's execution_mode sequential,&lt;br&gt;or a cut-off reply?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="2330" y="210" width="260" height="100" as="geometry"/>
</mxCell>
<mxCell id="o_par" value="&lt;b&gt;no → run_in_parallel&lt;/b&gt;: prepare in order, then&lt;br&gt;asyncio.TaskGroup (≈ Promise.all, cancels the rest)&lt;br&gt;&lt;b&gt;yes → run_sequentially&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="2280" y="340" width="360" height="70" as="geometry"/>
</mxCell>
<mxCell id="o_rstart" value="emit tool_execution_start" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
