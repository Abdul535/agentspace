</mxCell>
<mxCell id="o_rend" value="emit tool_execution_end (as each call finishes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
