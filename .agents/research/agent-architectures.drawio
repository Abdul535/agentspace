<mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Three ways to host an agent: pi, opencode, CompanyOS (and agentspace today)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1510" height="40" as="geometry"/></mxCell><mxCell id="h0" value="&lt;b&gt;pi&lt;/b&gt;&lt;br&gt;terminal agent + libraries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="180" y="70" width="330" height="55" as="geometry"/></mxCell><mxCell id="h1" value="&lt;b&gt;opencode&lt;/b&gt;&lt;br&gt;local HTTP server + clients" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="520" y="70" width="330" height="55" as="geometry"/></mxCell><mxCell id="h2" value="&lt;b&gt;CompanyOS&lt;/b&gt;&lt;br&gt;cloud control plane + sandbox per session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="860" y="70" width="330" height="55" as="geometry"/></mxCell><mxCell id="h3" value="&lt;b&gt;agentspace (today)&lt;/b&gt;&lt;br&gt;for comparison" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="1200" y="70" width="330" height="55" as="geometry"/></mxCell><mxCell id="l0" value="&lt;b&gt;Client&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="135" width="150" height="95" as="geometry"/></mxCell><mxCell id="c0_0" value="You in a terminal (TUI)&lt;br&gt;or another app over RPC:&lt;br&gt;JSON commands on stdin, events on stdout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="180" y="135" width="330" height="95" as="geometry"/></mxCell><mxCell id="c0_1" value="TUI, desktop and web apps&lt;br&gt;talk to a local HTTP API + SSE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="135" width="330" height="95" as="geometry"/></mxCell><mxCell id="c0_2" value="Web, CLI, mobile, desktop&lt;br&gt;talk to apps/api in the cloud" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="135" width="330" height="95" as="geometry"/></mxCell><mxCell id="c0_3" value="Next.js web app → FastAPI&lt;br&gt;(/api rewrite)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1200" y="135" width="330" height="95" as="geometry"/></mxCell><mxCell id="l1" value="&lt;b&gt;Process / topology&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="150" height="95" as="geometry"/></mxCell><mxCell id="c1_0" value="One pi process on your machine&lt;br&gt;(interactive, print or rpc mode)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="180" y="240" width="330" height="95" as="geometry"/></mxCell><mxCell id="c1_1" value="One opencode server process,&lt;br&gt;local on your machine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="240" width="330" height="95" as="geometry"/></mxCell><mxCell id="c1_2" value="apps/api (control plane: auth, DB, billing)&lt;br&gt;→ signed sandbox-proxy →&lt;br&gt;kortixd daemon inside each sandbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="240" width="330" height="95" as="geometry"/></mxCell><mxCell id="c1_3" value="One FastAPI process&lt;br&gt;on the host" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1200" y="240" width="330" height="95" as="geometry"/></mxCell><mxCell id="l2" value="&lt;b&gt;Who owns a run&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="345" width="150" height="95" as="geometry"/></mxCell><mxCell id="c2_0" value="The Agent object (agent.ts):&lt;br&gt;activeRun + AbortController,&lt;br&gt;subscribe(), steer / follow-up queues" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="180" y="345" width="330" height="95" as="geometry"/></mxCell><mxCell id="c2_1" value="Run coordinator: one execution per&lt;br&gt;session; POST /prompt writes the DB&lt;br&gt;inbox (steer | queue), then wake()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="345" width="330" height="95" as="geometry"/></mxCell><mxCell id="c2_2" value="kortixd in the box: pi's Agent,&lt;br&gt;imported as a library;&lt;br&gt;…/sessions/:id/prompt | steer | abort" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="345" width="330" height="95" as="geometry"/></mxCell><mxCell id="c2_3" value="The HTTP request: closing the&lt;br&gt;SSE stream cancels the run&lt;br&gt;(step 13 changes this)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1200" y="345" width="330" height="95" as="geometry"/></mxCell><mxCell id="l3" value="&lt;b&gt;Agent loop&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="450" width="150" height="95" as="geometry"/></mxCell><mxCell id="c3_0" value="runLoop (agent-loop.ts):&lt;br&gt;hooks, parallel tools, queues" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="180" y="450" width="330" height="95" as="geometry"/></mxCell><mxCell id="c3_1" value="Session runner (session/runner/),&lt;br&gt;written with Effect fibers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="450" width="330" height="95" as="geometry"/></mxCell><mxCell id="c3_2" value="pi's loop, unchanged&lt;br&gt;(pi-agent-core 1.4.0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="450" width="330" height="95" as="geometry"/></mxCell><mxCell id="c3_3" value="run_loop (agent/loop.py):&lt;br&gt;our own port of pi's runLoop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1200" y="450" width="330" height="95" as="geometry"/></mxCell><mxCell id="l4" value="&lt;b&gt;Where tools run&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="555" width="150" height="95" as="geometry"/></mxCell><mxCell id="c4_0" value="Same process, your machine (cwd).&lt;br&gt;Swappable *Operations can&lt;br&gt;send them elsewhere (e.g. SSH)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="180" y="555" width="330" height="95" as="geometry"/></mxCell><mxCell id="c4_1" value="On your machine, guarded by&lt;br&gt;permission rules (allow / ask / deny)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="555" width="330" height="95" as="geometry"/></mxCell><mxCell id="c4_2" value="Inside the session's sandbox&lt;br&gt;(/workspace; the agent clones&lt;br&gt;the repo when it needs it)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="555" width="330" height="95" as="geometry"/></mxCell><mxCell id="c4_3" value="Host folder data/workspaces/&amp;lt;id&amp;gt;/&lt;br&gt;(ADR-004: behind a Workspace&lt;br&gt;protocol, then a sandbox)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1200" y="555" width="330" height="95" as="geometry"/></mxCell><mxCell id="l5" value="&lt;b&gt;Approvals&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="150" height="95" as="geometry"/></mxCell><mxCell id="c5_0" value="Extension UI request event →&lt;br&gt;client answers with a response&lt;br&gt;command (RPC)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="180" y="660" width="330" height="95" as="geometry"/></mxCell><mxCell id="c5_1" value="Pending request (a Deferred);&lt;br&gt;GET …/permission, POST …/reply;&lt;br&gt;nobody present → deny" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="660" width="330" height="95" as="geometry"/></mxCell><mxCell id="c5_2" value="POST /permissions/:id/reply&lt;br&gt;(through the proxy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="660" width="330" height="95" as="geometry"/></mxCell><mxCell id="c5_3" value="before_tool_call hook exists,&lt;br&gt;not wired into the app yet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1200" y="660" width="330" height="95" as="geometry"/></mxCell><mxCell id="l6" value="&lt;b&gt;Events to the client&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="765" width="150" height="95" as="geometry"/></mxCell><mxCell id="c6_0" value="subscribe(): a late listener reads&lt;br&gt;the Agent's state, then new events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="180" y="765" width="330" height="95" as="geometry"/></mxCell><mxCell id="c6_1" value="GET /api/event: one global SSE,&lt;br&gt;15 s heartbeat, no replay:&lt;br&gt;refetch over REST, then listen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="765" width="330" height="95" as="geometry"/></mxCell><mxCell id="c6_2" value="Daemon GET /events → proxy → client;&lt;br&gt;/log serves the transcript&lt;br&gt;(kortix.transcript.v1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="765" width="330" height="95" as="geometry"/></mxCell><mxCell id="c6_3" value="One SSE response per prompt&lt;br&gt;(POST /sessions/{id}/messages)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1200" y="765" width="330" height="95" as="geometry"/></mxCell><mxCell id="l7" value="&lt;b&gt;Storage and recovery&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="870" width="150" height="95" as="geometry"/></mxCell><mxCell id="c7_0" value="Session files on disk.&lt;br&gt;pi-durable (experimental): commit&lt;br&gt;before showing, resume after a crash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="180" y="870" width="330" height="95" as="geometry"/></mxCell><mxCell id="c7_1" value="SQLite: sessions, inbox, and a&lt;br&gt;'turn in flight' claim, so a turn&lt;br&gt;resumes after a restart" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="870" width="330" height="95" as="geometry"/></mxCell><mxCell id="c7_2" value="Cloud DB + transcript log;&lt;br&gt;snapshot images; sandboxes stop&lt;br&gt;when idle and wake on request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="870" width="330" height="95" as="geometry"/></mxCell><mxCell id="c7_3" value="SQLite; each message saved&lt;br&gt;at message_end" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1200" y="870" width="330" height="95" as="geometry"/></mxCell><mxCell id="l8" value="&lt;b&gt;Model keys&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="975" width="150" height="95" as="geometry"/></mxCell><mxCell id="c8_0" value="On your machine&lt;br&gt;(env vars or OAuth)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="180" y="975" width="330" height="95" as="geometry"/></mxCell><mxCell id="c8_1" value="On your machine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="975" width="330" height="95" as="geometry"/></mxCell><mxCell id="c8_2" value="Never in the box: an LLM gateway&lt;br&gt;holds them; the box has a scoped&lt;br&gt;KORTIX_TOKEN. Git: branch-only proxy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="975" width="330" height="95" as="geometry"/></mxCell><mxCell id="c8_3" value="In apps/api/.env on the server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1200" y="975" width="330" height="95" as="geometry"/></mxCell><mxCell id="take" value="&lt;b&gt;The big split: where does the loop run?&lt;/b&gt;&lt;br&gt;pi and opencode run the loop and the tools on the user's own machine, so the user's own keys and files are fair game, and permission rules are the guard.&lt;br&gt;CompanyOS serves many users from the cloud, so it moves the whole harness into a sandbox per session and keeps secrets out with an LLM gateway and a git proxy.&lt;br&gt;ADR-004 sits in between: the loop and keys stay on our server, and only the tools go into the sandbox." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1090" width="1510" height="100" as="geometry"/></mxCell></root></mxGraphModel>