{
  "openapi": "3.1.0",
  "info": {
    "title": "agentspace",
    "version": "0.1.0"
  },
  "paths": {
    "/sessions": {
      "get": {
        "tags": [
          "sessions"
        ],
        "summary": "List Sessions",
        "description": "All sessions, most recently active first.",
        "operationId": "list_sessions_sessions_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SessionPublic"
                  },
                  "type": "array",
                  "title": "Response List Sessions Sessions Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "sessions"
        ],
        "summary": "Create Session",
        "description": "Create a session; the provider must be registered.",
        "operationId": "create_session_sessions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionPublic"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{session_id}": {
      "get": {
        "tags": [
          "sessions"
        ],
        "summary": "Get Session",
        "description": "One session and its saved transcript; while it runs, `GET .../events` also has the reply in progress.",
        "operationId": "get_session_sessions__session_id__get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "sessions"
        ],
        "summary": "Update Session",
        "description": "Switch the session's model; the next run uses it. 409 while a run is in progress.",
        "operationId": "update_session_sessions__session_id__patch",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionPublic"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{session_id}/messages": {
      "post": {
        "tags": [
          "sessions"
        ],
        "summary": "Send Message",
        "description": "Start a run on a new user message and stream its events as SSE.\n\nEach SSE `data` field is one `AgentEvent` as JSON; its `type` names the event.\nThe server owns the run (ADR-007): closing this stream only stops listening.\nReattach with `GET .../events`; stop the run with `POST .../abort`.",
        "operationId": "send_message_sessions__session_id__messages_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PromptCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "string",
                      "contentMediaType": "application/json",
                      "contentSchema": {
                        "$ref": "#/components/schemas/AgentEvent"
                      }
                    },
                    "event": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "retry": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{session_id}/events": {
      "get": {
        "tags": [
          "sessions"
        ],
        "summary": "Watch Session",
        "description": "Attach to the session's run: a `run_snapshot` first, then live events until the run ends.\n\nWith no run in progress, the stream is one snapshot of the saved transcript.",
        "operationId": "watch_session_sessions__session_id__events_get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "string",
                      "contentMediaType": "application/json",
                      "contentSchema": {
                        "anyOf": [
                          {
                            "$ref": "#/components/schemas/RunSnapshot"
                          },
                          {
                            "$ref": "#/components/schemas/AgentEvent"
                          }
                        ],
                        "title": "Streamitem Watch Session Sessions  Session Id  Events Get"
                      }
                    },
                    "event": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "retry": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{session_id}/abort": {
      "post": {
        "tags": [
          "sessions"
        ],
        "summary": "Abort Run",
        "description": "Stop the session's run; finished messages are kept. 409 if nothing is running.",
        "operationId": "abort_run_sessions__session_id__abort_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/models": {
      "get": {
        "tags": [
          "models"
        ],
        "summary": "List Models",
        "description": "The catalog; 502 when OpenRouter can't be reached and nothing is cached.",
        "operationId": "list_models_models_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelCatalog"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentEndEvent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "agent_end",
            "title": "Type",
            "default": "agent_end"
          },
          "reason": {
            "$ref": "#/components/schemas/EndReason"
          },
          "new_messages": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "type": "array",
            "title": "New Messages"
          }
        },
        "type": "object",
        "required": [
          "reason",
          "new_messages"
        ],
        "title": "AgentEndEvent",
        "description": "The run is over; lists every message it added to the transcript."
      },
      "AgentEvent": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/AgentStartEvent"
          },
          {
            "$ref": "#/components/schemas/TurnStartEvent"
          },
          {
            "$ref": "#/components/schemas/MessageStartEvent"
          },
          {
            "$ref": "#/components/schemas/MessageUpdateEvent"
          },
          {
            "$ref": "#/components/schemas/MessageEndEvent"
          },
          {
            "$ref": "#/components/schemas/ToolExecutionStartEvent"
          },
          {
            "$ref": "#/components/schemas/ToolExecutionUpdateEvent"
          },
          {
            "$ref": "#/components/schemas/ToolExecutionEndEvent"
          },
          {
            "$ref": "#/components/schemas/TurnEndEvent"
          },
          {
            "$ref": "#/components/schemas/AgentEndEvent"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "agent_end": "#/components/schemas/AgentEndEvent",
            "agent_start": "#/components/schemas/AgentStartEvent",
            "message_end": "#/components/schemas/MessageEndEvent",
            "message_start": "#/components/schemas/MessageStartEvent",
            "message_update": "#/components/schemas/MessageUpdateEvent",
            "tool_execution_end": "#/components/schemas/ToolExecutionEndEvent",
            "tool_execution_start": "#/components/schemas/ToolExecutionStartEvent",
            "tool_execution_update": "#/components/schemas/ToolExecutionUpdateEvent",
            "turn_end": "#/components/schemas/TurnEndEvent",
            "turn_start": "#/components/schemas/TurnStartEvent"
          }
        }
      },
      "AgentStartEvent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "agent_start",
            "title": "Type",
            "default": "agent_start"
          }
        },
        "type": "object",
        "title": "AgentStartEvent",
        "description": "A run started."
      },
      "AssistantMessage": {
        "properties": {
          "role": {
            "type": "string",
            "const": "assistant",
            "title": "Role",
            "default": "assistant"
          },
          "content": {
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/TextContent"
                },
                {
                  "$ref": "#/components/schemas/ToolCall"
                }
              ],
              "discriminator": {
                "propertyName": "type",
                "mapping": {
                  "text": "#/components/schemas/TextContent",
                  "tool_call": "#/components/schemas/ToolCall"
                }
              }
            },
            "type": "array",
            "title": "Content",
            "default": []
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage",
            "default": {
              "input": 0,
              "output": 0,
              "total": 0
            }
          },
          "stop_reason": {
            "$ref": "#/components/schemas/StopReason",
            "default": "stop"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          },
          "timestamp": {
            "type": "integer",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "provider",
          "model"
        ],
        "title": "AssistantMessage",
        "description": "One model reply: text and tool calls, plus how and why it ended."
      },
      "EndReason": {
        "type": "string",
        "enum": [
          "done",
          "max_turns",
          "error",
          "aborted",
          "terminated",
          "finish_turn"
        ]
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Message": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/UserMessage"
          },
          {
            "$ref": "#/components/schemas/AssistantMessage"
          },
          {
            "$ref": "#/components/schemas/ToolResultMessage"
          }
        ],
        "discriminator": {
          "propertyName": "role",
          "mapping": {
            "assistant": "#/components/schemas/AssistantMessage",
            "tool_result": "#/components/schemas/ToolResultMessage",
            "user": "#/components/schemas/UserMessage"
          }
        }
      },
      "MessageEndEvent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "message_end",
            "title": "Type",
            "default": "message_end"
          },
          "message": {
            "$ref": "#/components/schemas/Message"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "MessageEndEvent",
        "description": "A message is complete; this is the point where it gets saved."
      },
      "MessageStartEvent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "message_start",
            "title": "Type",
            "default": "message_start"
          },
          "message": {
            "$ref": "#/components/schemas/Message"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "MessageStartEvent",
        "description": "A message began; for an assistant reply the message is still empty."
      },
      "MessageUpdateEvent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "message_update",
            "title": "Type",
            "default": "message_update"
          },
          "event": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/TextDeltaEvent"
              },
              {
                "$ref": "#/components/schemas/ToolCallEndEvent"
              }
            ],
            "title": "Event",
            "discriminator": {
              "propertyName": "type",
              "mapping": {
                "text_delta": "#/components/schemas/TextDeltaEvent",
                "tool_call_end": "#/components/schemas/ToolCallEndEvent"
              }
            }
          }
        },
        "type": "object",
        "required": [
          "event"
        ],
        "title": "MessageUpdateEvent",
        "description": "Assistant messages only: one streamed piece of the message being generated."
      },
      "ModelCatalog": {
        "properties": {
          "default_model": {
            "type": "string",
            "title": "Default Model"
          },
          "favorites": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Favorites"
          },
          "models": {
            "items": {
              "$ref": "#/components/schemas/ModelInfo"
            },
            "type": "array",
            "title": "Models"
          }
        },
        "type": "object",
        "required": [
          "default_model",
          "favorites",
          "models"
        ],
        "title": "ModelCatalog",
        "description": "Every model a session can switch to, plus which ones to pin."
      },
      "ModelInfo": {
        "properties": {
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "context_length": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context Length"
          },
          "input_price": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Price"
          },
          "output_price": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Price"
          }
        },
        "type": "object",
        "required": [
          "provider",
          "id",
          "name",
          "context_length",
          "input_price",
          "output_price"
        ],
        "title": "ModelInfo",
        "description": "One model the picker can offer."
      },
      "PromptCreate": {
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "content"
        ],
        "title": "PromptCreate",
        "description": "A new user message to run the agent on."
      },
      "RunSnapshot": {
        "properties": {
          "type": {
            "type": "string",
            "const": "run_snapshot",
            "title": "Type",
            "default": "run_snapshot"
          },
          "running": {
            "type": "boolean",
            "title": "Running"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "type": "array",
            "title": "Messages"
          },
          "streaming": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AssistantMessage"
              },
              {
                "type": "null"
              }
            ]
          },
          "pending_tools": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Pending Tools",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "running",
          "messages"
        ],
        "title": "RunSnapshot",
        "description": "First event of `GET /sessions/{id}/events`: where the run is, so a late client can catch up."
      },
      "SessionCreate": {
        "properties": {
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "system_prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "System Prompt"
          },
          "tool_set": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ToolSetName"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "type": "object",
        "title": "SessionCreate",
        "description": "Fields for a new session; anything left out uses the app's defaults."
      },
      "SessionDetail": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "system_prompt": {
            "type": "string",
            "title": "System Prompt"
          },
          "tools": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tools"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "running": {
            "type": "boolean",
            "title": "Running",
            "default": false
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "type": "array",
            "title": "Messages"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "provider",
          "model",
          "system_prompt",
          "tools",
          "created_at",
          "updated_at",
          "messages"
        ],
        "title": "SessionDetail",
        "description": "A session with its full transcript."
      },
      "SessionPublic": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "system_prompt": {
            "type": "string",
            "title": "System Prompt"
          },
          "tools": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tools"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "running": {
            "type": "boolean",
            "title": "Running",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "provider",
          "model",
          "system_prompt",
          "tools",
          "created_at",
          "updated_at"
        ],
        "title": "SessionPublic",
        "description": "A session as the API returns it."
      },
      "SessionUpdate": {
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "title": "Model"
          }
        },
        "type": "object",
        "required": [
          "model"
        ],
        "title": "SessionUpdate",
        "description": "Fields to change on a session; only `model` for now (ADR-005)."
      },
      "StopReason": {
        "type": "string",
        "enum": [
          "stop",
          "length",
          "tool_use",
          "error",
          "aborted"
        ]
      },
      "TextContent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "text",
            "title": "Type",
            "default": "text"
          },
          "text": {
            "type": "string",
            "title": "Text"
